# Telegram
TRADECRAFT_TELEGRAM_BOT_TOKEN=
TRADECRAFT_TELEGRAM_CHAT_ID=
# Legacy aliases (optional)
# TELE_TOKEN=
# TELE_CHAT_ID=

# Upbit
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_BASE_URL=https://api.upbit.com

# Bithumb
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
BITHUMB_BASE_URL=https://api.bithumb.com

# Binance Spot (USDT/KRW is used for approximate KRW conversion)
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_USDT_KRW=1387

# Korea Investment (KIS) - Primary (your account)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_PRIMARY_APP_KEY=
KIS_PRIMARY_APP_SECRET=
KIS_PRIMARY_ACCOUNT_NO=
KIS_PRIMARY_PRODUCT_CODE=

# Korea Investment (KIS) - Secondary (wife account, balance-only)
KIS_SECONDARY_APP_KEY=
KIS_SECONDARY_APP_SECRET=
KIS_SECONDARY_ACCOUNT_NO=
KIS_SECONDARY_PRODUCT_CODE=

# Runtime
ENV=development
TZ=Asia/Seoul
TRADECRAFT_RUNTIME_STATE_PATH=.runtime/state.json
TRADECRAFT_RUNTIME_SESSIONS_PATH=
TRADECRAFT_RUNTIME_MAX_AGE_SEC=90
TRADECRAFT_RUNTIME_WRITE_INTERVAL_SEC=5

# Backtest Runtime
TRADECRAFT_BACKTEST_RESULT_PATH=.runtime/backtest_result.json
TRADECRAFT_BACKTEST_CYCLES=720
TRADECRAFT_BACKTEST_STEP_SEC=60
TRADECRAFT_BACKTEST_SPEED=120
TRADECRAFT_BACKTEST_INITIAL_PRICE=100000000
TRADECRAFT_BACKTEST_VOLATILITY_BPS=18
TRADECRAFT_BACKTEST_DRIFT_BPS=0.2
TRADECRAFT_BACKTEST_FEE_RATE=0.0005
TRADECRAFT_BACKTEST_SLIPPAGE_BPS=1
TRADECRAFT_BACKTEST_SEED=7
TRADECRAFT_BACKTEST_LIVE_STATE_PATH=.runtime/backtest_live.json
TRADECRAFT_BACKTEST_LIVE_EMIT_INTERVAL=2
TRADECRAFT_BACKTEST_LIVE_MAX_CURVE_POINTS=4000

# Server
TRADECRAFT_HOST=0.0.0.0
TRADECRAFT_PORT=8000
TRADECRAFT_ALLOW_ORIGINS=*
