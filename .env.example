# Telegram
TRADECRAFT_TELEGRAM_BOT_TOKEN=
TRADECRAFT_TELEGRAM_CHAT_ID=
# Legacy aliases (optional)
# TELE_TOKEN=
# TELE_CHAT_ID=

# Upbit
UPBIT_ACCESS_KEY=
UPBIT_SECRET_KEY=
UPBIT_BASE_URL=https://api.upbit.com

# Bithumb
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
BITHUMB_BASE_URL=https://api.bithumb.com

# Binance Spot (USDT/KRW is used for approximate KRW conversion)
BINANCE_SPOT_API_KEY=
BINANCE_SPOT_API_SECRET=
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_USDT_KRW=1387
USD_KRW=1387
FX_CACHE_TTL_SEC=30

# Freqtrade API bridge (optional; if username/password omitted, config path is used)
FREQTRADE_SPOT_API_URL=http://127.0.0.1:8080
FREQTRADE_SPOT_USERNAME=
FREQTRADE_SPOT_PASSWORD=
FREQTRADE_SPOT_CONFIG_PATH=third_party/freqtrade/user_data/config_jurobot.json
FREQTRADE_FUTURES_API_URL=http://127.0.0.1:8081
FREQTRADE_FUTURES_USERNAME=
FREQTRADE_FUTURES_PASSWORD=
FREQTRADE_FUTURES_CONFIG_PATH=third_party/freqtrade/user_data/config_jurobot_futures.json
# Optional per-strategy(bot_id) URL overrides. Format: bot_id=url,bot_id=url
# FREQTRADE_BOT_API_URLS=spot=http://127.0.0.1:8080,freqai_reforcexy=http://127.0.0.1:8084
FREQTRADE_BOT_API_URLS=
FREQTRADE_EXECUTABLE_PATH=third_party/freqtrade/.venv-ft/bin/freqtrade
FREQTRADE_WORKDIR=third_party/freqtrade
FREQTRADE_RUNTIME_DIR=.runtime/freqtrade
FREQTRADE_STOP_TIMEOUT_SEC=8
FREQTRADE_TIMEOUT_SEC=3.5

# Korea Investment (KIS) - Primary (your account)
KIS_BASE_URL=https://openapi.koreainvestment.com:9443
KIS_PRIMARY_APP_KEY=
KIS_PRIMARY_APP_SECRET=
KIS_PRIMARY_ACCOUNT_NO=
KIS_PRIMARY_PRODUCT_CODE=

# Korea Investment (KIS) - Secondary (wife account, balance-only)
KIS_SECONDARY_APP_KEY=
KIS_SECONDARY_APP_SECRET=
KIS_SECONDARY_ACCOUNT_NO=
KIS_SECONDARY_PRODUCT_CODE=

# Runtime
TRADECRAFT_RUNTIME_STATE_PATH=.runtime/state.json
TRADECRAFT_RUNTIME_MAX_AGE_SEC=90
TRADECRAFT_RUNTIME_WRITE_INTERVAL_SEC=5
TRADECRAFT_RESEARCH_STATE_PATH=.runtime/research.json
TRADECRAFT_RESEARCH_MAX_AGE_SEC=3600
TRADECRAFT_RESEARCH_ENABLED=true
TRADECRAFT_RESEARCH_RUN_INTERVAL_SEC=1800
TRADECRAFT_RESEARCH_MAX_ITEMS=20
TRADECRAFT_RESEARCH_KNOWLEDGE_MAX_CHARS=28000
TRADECRAFT_RESEARCH_ADVICE_CONTEXT_MAX_CHARS=2200
TRADECRAFT_RESEARCH_DB_REFERENCE_TOP_K=16
TRADECRAFT_RESEARCH_MARKET_SCOPE=KRX
TRADECRAFT_RESEARCH_CODEX_COMMAND=
TRADECRAFT_RESEARCH_CODEX_QUERY=국장 스윙/단타 후보 종목 리서치
TRADECRAFT_RESEARCH_CODEX_TIMEOUT_SEC=120

# Shared LLM bridge (runju-compatible)
TRADECRAFT_LLM_BRIDGE_COMMAND=
TRADECRAFT_LLM_BRIDGE_ARGS=
TRADECRAFT_LLM_BRIDGE_URL=
TRADECRAFT_LLM_BRIDGE_TOKEN=
TRADECRAFT_LLM_BRIDGE_TIMEOUT_MS=60000
TRADECRAFT_LLM_MODEL=gpt-5.3-codex

TRADECRAFT_RESEARCH_REPORT_URLS=
TRADECRAFT_RESEARCH_STRATEGY_MD_PATH=.runtime/strategy_krx.md

# KIS LLM trader (primary account)
TRADECRAFT_KIS_TRADER_ENABLED=false
TRADECRAFT_KIS_TRADER_STATE_PATH=.runtime/kis_trader.json
TRADECRAFT_KIS_TRADER_INTERVAL_SEC=300
TRADECRAFT_KIS_TRADER_LLM_COMMAND=
TRADECRAFT_KIS_TRADER_PERSONA=너는 한국 주식시장 초고수 트레이더다. 거시/수급/이슈를 종합해 보수적으로 판단한다.
TRADECRAFT_KIS_TRADER_MAX_ORDERS_PER_CYCLE=2
TRADECRAFT_KIS_TRADER_MAX_BUDGET_PER_ORDER_KRW=500000
TRADECRAFT_KIS_TRADER_MIN_CONFIDENCE=0.7
TRADECRAFT_KIS_TRADER_DEFAULT_ORDER_TYPE=01
TRADECRAFT_KIS_TRADER_ALLOW_SELL=true
TRADECRAFT_KIS_TRADER_MAX_CANDIDATE_CODES=10
TRADECRAFT_KIS_TRADER_REPORT_CONTEXT_TOP_K=6

# Naver securities report DB crawler
TRADECRAFT_NAVER_REPORTS_ENABLED=false
TRADECRAFT_NAVER_REPORTS_DB_PATH=.runtime/naver_reports.db
TRADECRAFT_NAVER_REPORTS_SEED_URL=https://finance.naver.com/research/company_list.naver
TRADECRAFT_NAVER_REPORTS_SEED_URLS=https://finance.naver.com/research/market_info_list.naver,https://finance.naver.com/research/invest_list.naver,https://finance.naver.com/research/company_list.naver,https://finance.naver.com/research/industry_list.naver,https://finance.naver.com/research/economy_list.naver,https://finance.naver.com/research/debenture_list.naver
TRADECRAFT_NAVER_REPORTS_INTERVAL_SEC=21600
TRADECRAFT_NAVER_REPORTS_MAX_PAGES=5
TRADECRAFT_NAVER_REPORTS_SINCE_DATE=2025-06-04
TRADECRAFT_NAVER_REPORTS_REQUEST_DELAY_SEC=1.8

# Optional RAG index for report chunks (ChromaDB)
TRADECRAFT_RAG_ENABLED=true
TRADECRAFT_RAG_PERSIST_PATH=.runtime/rag_chroma
TRADECRAFT_RAG_COLLECTION_NAME=naver_reports
TRADECRAFT_RAG_SYNC_CHUNK_LIMIT=50000
TRADECRAFT_RAG_QUERY_TOP_K=8

ENV=development
TZ=Asia/Seoul

# Server
PORT=8000
