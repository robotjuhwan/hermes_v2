{
  "workflow_id": "kis_idea_screen",
  "version": 1,
  "scope": "kis",
  "model_policy": {
    "default_model": "settings.llm_model",
    "default_reasoning_effort": "settings.llm_reasoning_effort",
    "expected_runtime_model": "gpt-5.6-terra",
    "expected_reasoning_effort": "xhigh"
  },
  "cadence": {"kind": "ad_hoc", "trigger": "screen_request"},
  "required_skills": ["idea_generation", "sector_overview", "valuation_frame", "evidence_audit"],
  "required_context": ["market_pulse", "quotes", "reports", "investment_memory", "watchlist", "sector_map"],
  "output_contracts": ["decision_lifecycle_contract", "evidence_claim_contract"],
  "authority": {
    "can_read_untrusted_research": false,
    "can_write_memory": true,
    "can_create_blocks": false,
    "can_submit_orders": false
  },
  "safety_gates": ["evidence_freshness", "duplicate_symbol_check", "no_order_submission"],
  "prompt_budget": {"max_skill_chars": 7600, "max_workflow_chars": 1600, "max_contract_chars": 5200}
}
